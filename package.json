{
  "name": "dsh-whale-pet",
  "description": "DeepSeek Whale-chan pet for DSH Web GUI with balance, tasks, quotas, and importable interactive Live2D models",
  "version": "0.4.1",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/live2d.js",
    "lib/live2d-zip-worker.js",
    "lib/live2dcubismcore.min.js",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "ASSET_NOTICE.md",
    "docs",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ali8772/dsh-web-gui.git"
  },
  "homepage": "https://github.com/ali8772/dsh-web-gui#readme",
  "bugs": {
    "url": "https://github.com/ali8772/dsh-web-gui/issues"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "plugin",
    "web-gui",
    "desktop-pet",
    "whale-chan",
    "live2d",
    "cubism"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/live2d.js && node --check lib/live2d-zip-worker.js && node --check lib/live2dcubismcore.min.js",
    "check:size": "node scripts/bundle-budget.mjs",
    "audit:prod": "node scripts/audit-production.mjs",
    "pack:plugin": "npm run build && npm test && npm run typecheck && npm run check && npm run check:size && npm run audit:prod && npm pack"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-host-webserver": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-connection": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-credentials": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.2-rc.1",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.25.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10"
  }
}
